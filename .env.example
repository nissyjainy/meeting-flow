# Supabase — copy to .env.local and fill from:
# https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# In Supabase Dashboard → Authentication → URL Configuration, add:
#   Site URL: http://localhost:8080 (or your production origin)
#   Redirect URLs:
#     http://localhost:8080/auth/callback
#     https://meeting-flow.nisargjain.workers.dev/auth/callback

# Groq (server-side only; do NOT prefix with VITE_)
# Create an API key: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
# Optional override (defaults to whisper-large-v3)
GROQ_WHISPER_MODEL=whisper-large-v3
# Optional chat model for meeting summaries (defaults to llama-3.3-70b-versatile)
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Resend — task reminder emails (server-side; also exposed via vite envPrefix)
# https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev
# App URL for meeting links in emails
APP_URL=http://localhost:8080
# Days ahead to treat deadlines as "upcoming" (default 7)
REMINDER_UPCOMING_DAYS=7
# Recipient for reminders (recommended for local dev — checked before auth email)
REMINDER_EMAIL_TO=you@example.com
# Optional: daily cron + POST /api/cron/task-reminders (dev allows empty secret)
CRON_SECRET=your-cron-secret
# Optional: Supabase service role for scheduled digests across all users
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar (server-side OAuth; do NOT prefix with VITE_)
# Create OAuth credentials: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override (defaults to {APP_URL}/api/integrations/google/callback)
GOOGLE_OAUTH_REDIRECT_URI=
# Days ahead to import upcoming events (default 30)
GOOGLE_CALENDAR_SYNC_HORIZON_DAYS=30
