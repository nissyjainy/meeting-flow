{
  "manifest_version": 3,
  "name": "MeetFlow Meet Capture",
  "version": "0.1.7",
  "description": "Capture Google Meet tab audio plus microphone, mix, and upload to MeetFlow for transcription.",
  "permissions": ["tabCapture", "storage", "tabs", "activeTab", "offscreen"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://*.supabase.co/*",
    "https://meeting-flow.nisargjain.workers.dev/*",
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MeetFlow Meet Capture"
  }
}
