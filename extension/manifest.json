{
  "manifest_version": 3,
  "name": "MeetFlow Meet Capture",
  "version": "0.2.3",
  "description": "Capture Google Meet, Zoom, or Microsoft Teams tab audio plus microphone, mix, and upload to MeetFlow for transcription.",
  "permissions": ["tabCapture", "storage", "tabs", "activeTab", "offscreen", "identity"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://app.zoom.us/*",
    "https://zoom.us/*",
    "https://*.zoom.us/*",
    "https://zoom.com/*",
    "https://*.zoom.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://teams.cloud.microsoft/*",
    "https://your-app.workers.dev/*",
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MeetFlow Meet Capture"
  }
}
